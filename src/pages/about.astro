---
import MainLayout from "@layouts/MainLayout.astro";
import Github from "@icons/github.astro";
import Linkedin from "@icons/linkedin.astro";
import Profile from "@assets/profile.webp";
import NewSletter from "@components/NewSletter.astro";
import { Image } from "astro:assets";
import { loadData } from "@utils/load-data.ts";

interface Props {
  language: string;
}
let { language } = Astro.props;
let data: SiteData = await loadData(language);
if (!language) {
  language = data.language;
}

const { aboutAuthor, aboutSite, rebrand } = data.about;
const iconLink =
  "inline-flex h-10 w-10 items-center justify-center rounded-md text-gray-700 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white";
---

<MainLayout
  {data}
  description={data.about.description}
  currentPath={data.about.path}
  {language}
  title={data.about.title}
>
  <div class="max-w-3xl">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white lg:text-4xl">
      {data.about.title}
    </h1>

    <section
      aria-labelledby="author-name"
      class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-start"
    >
      <Image
        src={Profile}
        width={144}
        height={144}
        alt={aboutAuthor.photoAlt}
        class="h-36 w-36 shrink-0 rounded-full object-cover ring-2 ring-primary-700 ring-offset-4 ring-offset-white dark:ring-primary-400 dark:ring-offset-gray-900"
      />
      <div>
        <h2 id="author-name" class="text-2xl font-bold text-gray-900 dark:text-white">
          {aboutAuthor.title}
        </h2>
        <p class="mt-1 text-gray-600 dark:text-gray-400">
          {aboutAuthor.role} · {aboutAuthor.location}
        </p>
        <p class="mt-4 max-w-[60ch] leading-relaxed text-gray-700 dark:text-gray-300">
          {aboutAuthor.description}
        </p>
        <ul class="-ml-2.5 mt-3 flex gap-1">
          <li>
            <a href="https://github.com/LoneExile" target="_blank" rel="noopener noreferrer" class={iconLink}>
              <Github color="fill-current" size="w-6 h-6" />
              <span class="sr-only">GitHub</span>
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/apinant-moo/"
              target="_blank"
              rel="noopener noreferrer"
              class={iconLink}
            >
              <Linkedin color="fill-current" size="w-6 h-6" />
              <span class="sr-only">LinkedIn</span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <section aria-labelledby="about-site" class="mt-12">
      <h2 id="about-site" class="text-xl font-bold text-gray-900 dark:text-white">
        {aboutSite.title}
      </h2>
      <p class="mt-2 max-w-[60ch] leading-relaxed text-gray-700 dark:text-gray-300">
        {aboutSite.description}
      </p>
      <p class="mt-3 max-w-[60ch] leading-relaxed text-gray-700 dark:text-gray-300">
        {aboutSite.closing}
      </p>
    </section>

    <section aria-labelledby="about-rebrand" class="mt-10">
      <h2 id="about-rebrand" class="text-xl font-bold text-gray-900 dark:text-white">
        {rebrand.title}
      </h2>
      <p class="mt-2 max-w-[60ch] leading-relaxed text-gray-700 dark:text-gray-300">
        {rebrand.description}
      </p>
    </section>
  </div>

  <NewSletter {language} {data} />
</MainLayout>
