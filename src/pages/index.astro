---
import MainLayout from "@layouts/MainLayout.astro";
import Hero from "@components/Hero.astro";
import NewSletter from "@components/NewSletter.astro";
import ArchiveGrid from "@components/ArchiveGrid.astro";
import cat from "@assets/vintage-cat-rawpixel.com-jeanbernard.png";
import { getImage } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import { loadData, loadPublishedPosts } from "@utils/load-data.ts";

interface Props {
  language: string;
}

let { language } = Astro.props;
let data: SiteData = await loadData(language);
if (!language) {
  language = data.language;
}

const posts = await loadPublishedPosts(language);
const heroImage = await getImage({
  src: cat,
  width: 494,
  height: 494,
  densities: [1, 2],
  format: "webp",
});
const hero = { src: heroImage.src, srcset: heroImage.srcSet.attribute, width: 494, height: 494 };
---

<MainLayout
  {data}
  description={data.siteDescription}
  currentPath={data.home.path}
  {language}
  title={data.siteTitle}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={hero.src}
    imagesrcset={hero.srcset}
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <Hero {data} image={hero} />
  <ArchiveGrid {posts} {language} {data} />
  {/* The grid is decoration (hidden from keyboards and screen readers), so
      this link is the home page's own way into the posts. */}
  <p class="mt-6 text-center">
    <a
      href={getRelativeLocaleUrl(language, "articles")}
      class="inline-block py-2 font-medium text-primary-700 hover:underline dark:text-primary-400"
    >
      {data.home.grid.all} →
    </a>
  </p>

  <NewSletter {language} {data} />
</MainLayout>
