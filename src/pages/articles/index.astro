---
import MainLayout from "@layouts/MainLayout.astro";
import ArticleIndex from "@components/ArticleIndex.astro";
import { loadData, loadPublishedPosts } from "@utils/load-data.ts";

interface Props {
  language: string;
}
let { language } = Astro.props;
let data: SiteData = await loadData(language);
if (!language) {
  language = data.language;
}

const posts = await loadPublishedPosts(language);
---

<MainLayout
  {data}
  description={data.articles.description}
  currentPath="articles"
  {language}
  title={data.articles.title}
>
  <header class="max-w-3xl">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white lg:text-4xl">
      {data.articles.title}
    </h1>
    <p class="mt-2 text-gray-700 dark:text-gray-300">{data.articles.intro}</p>
  </header>
  <ArticleIndex {posts} {language} {data} />
</MainLayout>
