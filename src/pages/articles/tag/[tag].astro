---
import MainLayout from "@layouts/MainLayout.astro";
import ArticleIndex from "@components/ArticleIndex.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { loadData, loadPublishedPosts } from "@utils/load-data.ts";

export async function getStaticPaths() {
  const data: SiteData = await loadData("");
  const language = data.language;
  const posts = await loadPublishedPosts(language);
  const tags = new Set(posts.flatMap((post) => post.data.tags.map((tag) => tag.toLowerCase())));

  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      language,
      posts: posts.filter((post) => post.data.tags.some((postTag) => postTag.toLowerCase() === tag)),
    },
  }));
}

const { posts, language } = Astro.props;
const { tag } = Astro.params;
const data: SiteData = await loadData(language);
const title = `${data.tags.title} #${tag}`;
---

<MainLayout
  {data}
  description={`${data.tags.description}#${tag}`}
  currentPath="articles"
  {language}
  {title}
>
  <header class="max-w-3xl">
    <a
      href={getRelativeLocaleUrl(language, "articles")}
      class="text-sm font-medium text-primary-700 hover:underline dark:text-primary-400"
    >
      ← {data.tags.back}
    </a>
    <h1 class="mt-2 text-3xl font-bold text-gray-900 dark:text-white lg:text-4xl">{title}</h1>
  </header>
  <ArticleIndex {posts} {language} {data} />
</MainLayout>
