---
interface Props {
  color: string;
  size: string;
}
const { color, size } = Astro.props;
const iconClass = color + " " + size;

// Three stacked slabs ("archive layers"). Drawn on a 32 grid with each slab's
// top and bottom edge on a whole unit, so the rows stay sharp at 16, 32 and
// 48 px (the slanted sides use half units). Fill follows the text colour.
// public/favicon.svg and the PNG icons use the same path.
---

<svg
  class={iconClass}
  viewBox="0 0 32 32"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path d="M11.5 2h9l3 6h-15zM8 12h16l3 6H5zM4.5 22h23l3 6h-29z"></path>
</svg>
