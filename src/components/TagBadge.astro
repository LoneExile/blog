---
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  tags: string[] | undefined;
  language: string;
}

const { tags, language } = Astro.props;
---

{
  tags && tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2" aria-label="Tags">
      {tags.map((tag) => (
        <li>
          <a
            href={getRelativeLocaleUrl(language, "articles/tag/" + tag.toLowerCase())}
            class="inline-flex min-h-7 items-center rounded-md border border-gray-300 px-2 text-xs font-medium text-gray-700 hover:border-primary-600 hover:text-primary-700 dark:border-gray-600 dark:text-gray-300 dark:hover:border-primary-400 dark:hover:text-primary-400"
          >
            #{tag.toLowerCase()}
          </a>
        </li>
      ))}
    </ul>
  )
}
