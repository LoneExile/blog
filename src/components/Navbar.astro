---
import ThemeSwitcher from "@components/theme/ThemeSwitcher.astro";
import LanguageSwitcher from "@components/language/LanguageSwitcher.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import Logo from "@icons/logo.astro";
import Hambuger from "@icons/hamburger2.astro";

interface Props {
  currentPath: string;
  language: string;
  data: SiteData;
}

const { currentPath, language, data } = Astro.props;

const getPath = (path: string) => {
  return getRelativeLocaleUrl(language, path);
};

type NavItem = {
  title: string;
  path: string;
};

const items: NavItem[] = [
  {
    title: data.navbar.home,
    path: getRelativeLocaleUrl(language, ""),
  },
  {
    title: data.navbar.articles,
    path: getRelativeLocaleUrl(language, "articles"),
  },
  {
    title: data.navbar.about,
    path: getRelativeLocaleUrl(language, "about"),
  },
];

// Article pages count as "Articles" for the active link.
const current = currentPath.startsWith("articles/")
  ? getPath("articles")
  : getPath(currentPath);
---

<header class="bg-white dark:bg-gray-900">
  <nav
    aria-label={data.navbar.label}
    class="page-container flex flex-wrap items-center justify-between gap-y-2 py-4"
  >
    <a
      href={getRelativeLocaleUrl(language, "")}
      class="flex min-w-0 items-center gap-3"
    >
      <Logo color="text-primary-700 dark:text-primary-400" size="w-8 h-8 shrink-0" />
      <span class="text-xl font-bold sm:text-2xl">{data.siteTitle}</span>
    </a>
    <button
      type="button"
      data-menu-toggle
      class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800 md:hidden"
      aria-controls="navbar-default"
      aria-expanded="false"
      data-label-open={data.navbar.menuOpen}
      data-label-close={data.navbar.menuClose}
    >
      <span class="sr-only">{data.navbar.menuOpen}</span>
      <Hambuger color="fill-none" size="w-5 h-5" />
    </button>
    <div class="hidden w-full md:block md:w-auto" id="navbar-default">
      <ul
        class="flex flex-col gap-1 rounded-lg border border-gray-200 bg-gray-50 p-2 font-medium dark:border-gray-700 dark:bg-gray-800 md:flex-row md:items-center md:gap-6 md:border-0 md:bg-transparent md:p-0 md:dark:bg-transparent"
      >
        {
          items.map((item) =>
            item.path === current ? (
              <li>
                <a
                  href={item.path}
                  class="block rounded-md bg-primary-700 px-3 py-2.5 text-white md:bg-transparent md:p-0 md:text-primary-700 md:underline md:decoration-2 md:underline-offset-8 md:dark:text-primary-400"
                  aria-current="page"
                >
                  {item.title}
                </a>
              </li>
            ) : (
              <li>
                <a
                  href={item.path}
                  class="block rounded-md px-3 py-2.5 text-gray-900 hover:bg-gray-100 dark:text-white dark:hover:bg-gray-700 md:p-0 md:hover:bg-transparent md:hover:text-primary-700 md:dark:hover:bg-transparent md:dark:hover:text-primary-400"
                >
                  {item.title}
                </a>
              </li>
            ),
          )
        }
        <li class="px-1 pt-1 md:p-0">
          <ThemeSwitcher {data} />
          <div class="hidden">
            <LanguageSwitcher {language} {currentPath} />
          </div>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("navbar-default");
  const label = toggle?.querySelector(".sr-only");

  const setOpen = (open: boolean) => {
    if (!toggle || !menu || !label) return;
    menu.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    label.textContent = open
      ? (toggle.dataset.labelClose ?? "")
      : (toggle.dataset.labelOpen ?? "");
  };

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
