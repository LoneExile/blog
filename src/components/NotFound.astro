---
import PostRow from "@components/PostRow.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { loadPublishedPosts } from "@utils/load-data.ts";

interface Props {
  language: string;
  data: SiteData;
}

const { language, data } = Astro.props;
const t = data.pageNotFound;
const recent = (await loadPublishedPosts(language)).slice(0, 3);
---

<section class="max-w-3xl">
  <p class="text-sm font-bold uppercase tracking-wide text-primary-700 dark:text-primary-400">
    404
  </p>
  <h1 class="mt-2 text-3xl font-bold text-gray-900 dark:text-white lg:text-4xl">
    {t.heading}
  </h1>
  <p class="mt-3 text-lg text-gray-700 dark:text-gray-300">{t.body}</p>
  <p class="mt-4">
    <a
      href={getRelativeLocaleUrl(language, "articles")}
      class="font-medium text-primary-700 hover:underline dark:text-primary-400"
      >{t.browse} →</a
    >
  </p>

  <section aria-labelledby="recent-title" class="mt-12">
    <h2
      id="recent-title"
      class="border-b border-gray-200 pb-2 text-sm font-bold uppercase tracking-wide text-gray-600 dark:border-gray-700 dark:text-gray-400"
    >
      {t.recent}
    </h2>
    <ol class="divide-y divide-gray-200 dark:divide-gray-800">
      {
        recent.map((post) => (
          <li>
            <PostRow {post} {language} />
          </li>
        ))
      }
    </ol>
  </section>
</section>
