---
import PostRow from "@components/PostRow.astro";
import { loadPublishedPosts } from "@utils/load-data.ts";

interface Props {
  currentTags: string[];
  language: string;
  currentSlug: string;
  data: SiteData;
}
const { currentTags, language, currentSlug, data } = Astro.props;

const relatedPosts = (await loadPublishedPosts(language))
  .filter((post) => post.id !== currentSlug && post.data.tags.some((tag) => currentTags.includes(tag)))
  .slice(0, 3);
---

{
  relatedPosts.length > 0 && (
    <section aria-labelledby="related-title" class="mt-16">
      <h2 id="related-title" class="text-xl font-bold">
        {data.relateArticles.title}
      </h2>
      <ol class="divide-y divide-gray-200 dark:divide-gray-800">
        {relatedPosts.map((post) => (
          <li>
            <PostRow {post} {language} />
          </li>
        ))}
      </ol>
    </section>
  )
}
