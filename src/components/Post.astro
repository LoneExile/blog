---
import { formattedDate, isoDate } from "@utils/utils";
import Profile from "@assets/profile.webp";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";

interface Props {
  title: string;
  created: string;
  language: string;
  data: SiteData;
  /** Articles show the author byline; the legal pages show "Last updated". */
  byline: boolean;
  updated?: string;
}

const { title, created, updated, language, data, byline } = Astro.props;
---

<article class="reading-column">
  <header class="mb-8">
    {
      byline && (
        <address class="mb-6 flex items-center gap-4 not-italic">
          <Image class="h-14 w-14 rounded-full" src={Profile} alt="" width={112} height={112} />
          <div class="text-sm">
            <a
              href={getRelativeLocaleUrl(language, "about")}
              rel="author"
              class="text-base font-bold text-gray-900 hover:underline dark:text-white"
            >
              {data.author}
            </a>
            <p class="text-gray-600 dark:text-gray-400">
              {data.about.aboutAuthor.role} ·{" "}
              <time datetime={isoDate(created)}>{formattedDate(created)}</time>
            </p>
          </div>
        </address>
      )
    }
    <h1 class="text-3xl font-bold leading-tight text-gray-900 dark:text-white lg:text-4xl">
      {title}
    </h1>
    {
      !byline && updated && (
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
          {data.post.lastUpdated}{" "}
          <time datetime={isoDate(updated)}>{formattedDate(updated)}</time>
        </p>
      )
    }
  </header>
  <div class="format format-brand sm:format-base lg:format-lg max-w-none">
    <slot />
  </div>
</article>
