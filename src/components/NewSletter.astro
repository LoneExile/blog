---
import { getRelativeLocaleUrl } from "astro:i18n";
import Email from "@icons/email.astro";

interface Props {
  language: string;
  data: SiteData;
}
const { language, data } = Astro.props;
const t = data.newSletter;
---

<section
  aria-labelledby="newsletter-title"
  class="mt-16 border-t border-gray-200 pt-10 dark:border-gray-800"
>
  <div class="max-w-xl">
    <h2 id="newsletter-title" class="text-xl font-bold">{t.title}</h2>
    <p class="mt-1 text-gray-600 dark:text-gray-400">{t.description}</p>

    <form
      id="subscription-form"
      method="post"
      class="mt-5 flex flex-col gap-3 sm:flex-row sm:gap-0"
      data-sitekey={import.meta.env.PUBLIC_TURNSTILE_KEY}
      data-msg-need-check={t.needCheck}
      data-msg-checking={t.checking}
      data-msg-check-failed={t.checkFailed}
      data-msg-success={t.success}
      data-msg-error={t.error}
      data-msg-busy={t.busy}
      data-msg-button={t.button}
    >
      <div class="relative w-full">
        <label for="email" class="sr-only">{t.label}</label>
        <div
          class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 dark:text-gray-400"
        >
          <Email color="fill-current" size="w-4 h-4" />
        </div>
        <input
          class="block h-12 w-full rounded-lg border border-gray-500 bg-white pl-9 pr-3 text-base text-gray-900 placeholder:text-gray-500 dark:border-gray-500 dark:bg-gray-800 dark:text-white dark:placeholder:text-gray-400 sm:rounded-r-none"
          placeholder={t.placeholder}
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
        />
      </div>
      <button
        id="subscribe"
        type="submit"
        class="h-12 shrink-0 cursor-pointer rounded-lg bg-primary-700 px-5 font-medium text-white hover:bg-primary-800 disabled:cursor-wait disabled:opacity-80 dark:bg-primary-600 dark:hover:bg-primary-700 sm:rounded-l-none"
      >
        {t.button}
      </button>
    </form>

    <div class="cf-turnstile mt-3 empty:hidden"></div>
    <p
      id="subscribe-status"
      role="status"
      class="mt-2 min-h-6 text-sm font-medium data-[state=error]:text-red-700 data-[state=success]:text-green-700 dark:data-[state=error]:text-red-400 dark:data-[state=success]:text-green-400"
    >
    </p>

    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
      {t.subDescription}{" "}
      <a
        href={getRelativeLocaleUrl(language, "privacy-policy")}
        class="font-medium text-primary-700 underline underline-offset-2 hover:no-underline dark:text-primary-400"
        >{t.privacyPolicyLink}</a
      >
    </p>
  </div>
</section>

<script>
  // Turnstile loads on the first focus or tap inside the form (keyboard and
  // pointer alike), so pages that never touch the form never contact Cloudflare.
  type Turnstile = {
    render: (el: Element, opts: Record<string, unknown>) => string;
    reset: (id?: string) => void;
    remove: (id: string) => void;
  };
  const win = window as unknown as {
    turnstile?: Turnstile;
    onTurnstileLoad?: () => void;
  };

  const form = document.getElementById("subscription-form") as HTMLFormElement | null;
  const box = document.querySelector(".cf-turnstile");
  const status = document.getElementById("subscribe-status");
  const button = document.getElementById("subscribe") as HTMLButtonElement | null;
  const email = document.getElementById("email") as HTMLInputElement | null;

  if (form && box && status && button && email) {
    const msg = form.dataset;
    let loading: Promise<void> | null = null;
    let widgetId: string | undefined;
    let token = "";
    let submitWhenReady = false;

    const setStatus = (text = "", state = "") => {
      status.textContent = text;
      status.dataset.state = state;
    };

    const load = () =>
      (loading ??= new Promise<void>((resolve, reject) => {
        win.onTurnstileLoad = () => resolve();
        const script = document.createElement("script");
        script.src =
          "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad";
        script.async = true;
        script.onerror = () => reject(new Error("turnstile script failed"));
        document.head.appendChild(script);
      }));

    const render = () => {
      const turnstile = win.turnstile;
      if (!turnstile) return;
      if (widgetId !== undefined) turnstile.remove(widgetId);
      token = "";
      widgetId = turnstile.render(box, {
        sitekey: msg.sitekey,
        theme: document.documentElement.classList.contains("dark") ? "dark" : "light",
        size: window.innerWidth < 600 ? "compact" : "normal",
        callback: (value: string) => {
          token = value;
          if (submitWhenReady) {
            submitWhenReady = false;
            form.requestSubmit();
          } else if (status.dataset.state === "pending") {
            setStatus();
          }
        },
        "expired-callback": () => {
          token = "";
        },
        "error-callback": () => {
          token = "";
          submitWhenReady = false;
          setStatus(msg.msgCheckFailed, "error");
        },
      });
    };

    const start = () => {
      load()
        .then(() => {
          if (widgetId === undefined) render();
        })
        .catch(() => setStatus(msg.msgCheckFailed, "error"));
    };

    form.addEventListener("focusin", start, { once: true });
    form.addEventListener("pointerdown", start, { once: true });

    // A theme switch redraws an unsolved check in the new colours.
    window.addEventListener("theme-change", () => {
      if (widgetId !== undefined && !token) render();
    });

    const setBusy = (busy: boolean) => {
      button.disabled = busy;
      button.textContent = (busy ? msg.msgBusy : msg.msgButton) ?? "";
    };

    form.addEventListener("submit", async (event) => {
      // Never let the browser submit the form itself: that would reload the
      // page with the address in the URL.
      event.preventDefault();
      if (!token) {
        submitWhenReady = true;
        setStatus(widgetId === undefined ? msg.msgChecking : msg.msgNeedCheck, "pending");
        start();
        return;
      }

      setBusy(true);
      try {
        const response = await fetch(import.meta.env.PUBLIC_TURNSTILE_HANDLE_API, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email.value, captchaToken: token }),
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        form.reset();
        setStatus(msg.msgSuccess, "success");
      } catch {
        setStatus(msg.msgError, "error");
      } finally {
        setBusy(false);
        // Tokens are single use: get a fresh one for the next attempt.
        token = "";
        if (widgetId !== undefined) win.turnstile?.reset(widgetId);
      }
    });
  }
</script>
