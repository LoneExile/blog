---
interface Props {
  data: SiteData;
  /** The cat etching, already sized by the page (it also preloads it). */
  image: { src: string; srcset: string; width: number; height: number };
}

const { data, image } = Astro.props;
---

<section class="grid items-center gap-8 lg:grid-cols-12">
  <div class="lg:col-span-7">
    <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white md:text-5xl xl:text-6xl">
      {data.home.hero.title}
    </h1>
    <p class="mt-4 max-w-xl text-lg text-gray-700 dark:text-gray-300 md:text-xl">
      {data.home.hero.description}
    </p>
  </div>
  <div class="hidden lg:col-span-5 lg:flex lg:justify-end">
    <!-- Decorative. Hidden below lg, so it stays lazy there; on lg the page
         preloads it (media query) because it is the largest paint. -->
    <img
      class="dark:invert"
      src={image.src}
      srcset={image.srcset}
      width={image.width}
      height={image.height}
      alt=""
      loading="lazy"
      decoding="async"
      fetchpriority="high"
    />
  </div>
</section>
