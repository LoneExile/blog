---
import Sun from "@icons/sun.astro";
import Moon from "@icons/moon.astro";

interface Props {
  data: SiteData;
}
const { data } = Astro.props;
const size = "w-5 h-5";
---

<button
  id="theme-toggle"
  type="button"
  aria-pressed="false"
  class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-primary-700 text-primary-700 hover:bg-primary-700 hover:text-white dark:border-primary-400 dark:text-primary-400 dark:hover:bg-primary-400 dark:hover:text-gray-900"
>
  <span class="sr-only">{data.navbar.darkTheme}</span>
  <span class="hidden dark:inline"><Sun color="fill-current" size={size} /></span>
  <span class="dark:hidden"><Moon color="fill-current" size={size} /></span>
</button>

<script>
  // The theme itself is set before first paint by the inline script in
  // MainLayout. This button saves an explicit choice and announces it with a
  // "theme-change" event (comments and the newsletter check follow it).
  const root = document.documentElement;
  const button = document.getElementById("theme-toggle");
  const query = window.matchMedia("(prefers-color-scheme: dark)");

  const apply = (dark: boolean) => {
    root.classList.toggle("dark", dark);
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", dark ? "#1c1717" : "#ffffff");
    button?.setAttribute("aria-pressed", String(dark));
    window.dispatchEvent(
      new CustomEvent("theme-change", { detail: dark ? "dark" : "light" }),
    );
  };

  const saved = (): string | null => {
    try {
      return localStorage.getItem("settings:theme");
    } catch {
      return null;
    }
  };

  button?.setAttribute("aria-pressed", String(root.classList.contains("dark")));

  button?.addEventListener("click", () => {
    const dark = !root.classList.contains("dark");
    try {
      localStorage.setItem("settings:theme", dark ? "dark" : "light");
    } catch {}
    apply(dark);
  });

  // With no saved choice, keep following the device setting.
  query.addEventListener("change", (event) => {
    if (saved() === null) apply(event.matches);
  });
</script>
